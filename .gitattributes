# =========================================================
# .gitattributes cho repo RAG-1
# Mục tiêu: chuẩn hóa line ending để tránh cảnh báo LF/CRLF
# và tránh diff "giả" khi làm việc trên nhiều máy (Windows/Mac/Linux)
# =========================================================

# Mặc định: tự nhận diện file text, chuẩn hóa lưu trong Git là LF
* text=auto eol=lf

# ---- Mã nguồn & cấu hình: luôn LF (đồng nhất giữa các hệ điều hành) ----
*.py        text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.toml      text eol=lf
*.env       text eol=lf
*.example   text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf
README.md   text eol=lf

# ---- Script Windows: giữ CRLF (PowerShell/Batch chạy đúng chuẩn Windows) ----
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# ---- Script Unix shell: luôn LF (bắt buộc để chạy được trên Linux/Mac) ----
*.sh        text eol=lf

# ---- File nhị phân: không đụng vào, không normalize ----
*.pdf       binary
*.jpg       binary
*.jpeg      binary
*.png       binary
*.zip       binary
*.log       binary
*.db        binary
*.pkl       binary
*.bin       binary
*.model     binary
