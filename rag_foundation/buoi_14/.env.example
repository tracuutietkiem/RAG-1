# ============================================================================
# Buoi 14 - Hybrid Search + Reranking + Mini Knowledge Graph
# Copy file nay thanh .env roi dien gia tri. KHONG commit .env.
# ============================================================================

# --- Duong dan du lieu nguon (CHI DOC) -------------------------------------
# De trong -> code tu do lan luot: ../kb+hops, ../Buổi 12/ner_kb, ../buoi_12/ner_kb
KB_DIR=

# --- Chunking ---------------------------------------------------------------
MAX_CHUNK_CHARS=3000
MIN_CHUNK_CHARS=40

# --- Retrieval --------------------------------------------------------------
BM25_CANDIDATES=20
DENSE_CANDIDATES=20
CANDIDATE_K=20
FINAL_TOP_K=5
RRF_K=60
RRF_BM25_WEIGHT=1.0
RRF_DENSE_WEIGHT=1.0

# --- Dense backend ----------------------------------------------------------
# auto                  : thu sentence_transformers, that bai thi fallback lsa
# sentence_transformers : bat buoc dung embedding neural (can tai model)
# lsa                   : FALLBACK offline TF-IDF+SVD, KHONG phai neural
DENSE_BACKEND=auto
EMBEDDING_MODEL=thuannc/vi-distilled-msmarco-MiniLM-L12-cos-v5
EMBEDDING_DEVICE=cpu
LSA_DIM=256

# --- Reranker backend -------------------------------------------------------
# auto          : thu cross_encoder, that bai thi fallback lexical
# cross_encoder : bat buoc dung Cross-Encoder (tai ~2,27 GB lan dau)
# fallback      : lexical overlap, KHONG phai neural reranker
RERANKER_BACKEND=auto
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MAX_LENGTH=512
RERANK_BATCH_SIZE=4
RERANK_DEVICE=cpu

# --- Neo4j (Mini Knowledge Graph) ------------------------------------------
# Khong hard-code password trong code. De trong -> load_mini_kg.py bao NOT RUN
# va cac phan Retrieval/Streamlit van chay binh thuong.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
